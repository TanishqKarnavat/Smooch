# Required on Vercel for Production and Preview.
# Copy the TLS/TCP URL from the Upstash Redis "Connect" TCP panel (rediss://...).
# Do not use an Upstash REST URL or REST token.
UPSTASH_REDIS_URL=

# Local npm test only. Same TCP URL shape as UPSTASH_REDIS_URL. Not used by Vercel.
HEARTSYNC_TEST_REDIS_URL=
